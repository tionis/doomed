NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
SQLITE_PATH=.data/judged-by-ai.sqlite
SESSION_COOKIE_NAME=jba_session

# authentik OIDC provider settings.
# In authentik, create an OAuth2/OpenID Provider and Application.
# Issuer format is usually:
#   https://authentik.example.com/application/o/<application-slug>/
OIDC_PROVIDER=authentik
OIDC_ISSUER=https://authentik.example.com/application/o/judged-by-ai/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Use this for local Vite development because Vite proxies /auth to the backend.
# For the container on localhost:3000, use:
#   http://localhost:3000/auth/callback/authentik
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback/authentik

# Optional. Without this, the server uses the deterministic mock judge.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
