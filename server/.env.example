PORT=3001
# Host auth (OIDC). Guests stay anonymous, join by room code.
OIDC_ISSUER=https://your-idp.example.com
OIDC_CLIENT_ID=doomed-client-id
# Optional for confidential clients (PKCE public clients omit this).
OIDC_CLIENT_SECRET=
# Dev only: accept `Authorization: Bearer dev-host-token` as host.
OIDC_DEV_BYPASS=1
# Server-side LLM (replaces host-browser keys). Empty = mock judge.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# SCIM provisioning bearer token. Users provisioned with the `admin`
# entitlement pass the admin gate; deprovisioning revokes it.
SCIM_TOKEN=
# Comma-separated admin emails (in addition to the admin list + SCIM users).
ADMIN_EMAILS=
# Comma-separated allowed CORS origins. Empty = allow all (dev default).
CORS_ORIGINS=
# Age in ms after which unlinked rooms qualify for admin cleanup.
OLD_UNLINKED_MS=604800000
